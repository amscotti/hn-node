{
  "name": "hn-node",
  "version": "1.0.0",
  "type": "module",
  "description": "A fast Bun command-line application that fetches and displays the top stories from Hacker News.",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amscotti/hn-node.git"
  },
  "bugs": {
    "url": "https://github.com/amscotti/hn-node/issues"
  },
  "homepage": "https://github.com/amscotti/hn-node#readme",
  "bin": {
    "hn": "index.js"
  },
  "scripts": {
    "start": "bun index.js",
    "build": "bun build --compile --minify --outfile hn ./index.js",
    "lint": "standard",
    "lint:fix": "standard --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test",
    "test:coverage": "bun test --coverage"
  },
  "author": "Anthony Scotti",
  "license": "MIT",
  "engines": {
    "bun": ">=1.2.0"
  },
  "dependencies": {
    "chalk": "^6.0.1",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "standard": "^17.1.2"
  }
}
